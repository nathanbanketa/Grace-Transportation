NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated Supabase Auth user UUIDs.
ADMIN_USER_IDS=

SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Exact public subscription URL including /api/square/webhook.
SQUARE_WEBHOOK_URL=

RESEND_API_KEY=
BOOKING_FROM_EMAIL=

# Private, independently generated secrets of at least 32 characters.
BOOKING_RATE_LIMIT_SECRET=
CRON_SECRET=
DRIVER_NOTIFICATION_EMAIL=

# Optional driver-only Web Push. Generate a dedicated VAPID key pair per environment.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=

# Optional driver-only SMS. Use E.164 numbers and an approved Twilio sender.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
DRIVER_SMS_NUMBER=
